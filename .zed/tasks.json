[
    {
        "label": "Cargo: Check",
        "command": "cargo check",
        "use_new_terminal": false,
        "allow_concurrent_runs": false
    },
    {
        "label": "Cargo: Clippy",
        "command": "cargo clippy --all-targets --all-features -- -D warnings",
        "use_new_terminal": false,
        "allow_concurrent_runs": false
    },
    {
        "label": "Cargo: Build (Debug)",
        "command": "cargo build",
        "use_new_terminal": false,
        "allow_concurrent_runs": false
    },
    {
        "label": "Cargo: Run",
        "command": "cargo run",
        "use_new_terminal": false,
        "allow_concurrent_runs": false
    },
    {
        "label": "Cargo: Test",
        "command": "cargo test -- --nocapture",
        "use_new_terminal": false,
        "allow_concurrent_runs": false
    },
    {
        "label": "Cargo: Debug (Rust-GDB / LLDB)",
        "command": "rust-gdb -tui ./target/debug/rust_project",
        "use_new_terminal": true,
        "allow_concurrent_runs": false
    }
]
